{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-engineering-starter:m2:handoff:1.0",
  "title": "Handoff record 1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "current_objective": {
      "type": "string",
      "minLength": 1
    },
    "authorized_scope": {
      "type": "string",
      "minLength": 1
    },
    "work_completed": {
      "type": "string",
      "minLength": 1
    },
    "repository_revision": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "dirty_state": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "branch",
        "revision",
        "dirty_state"
      ],
      "additionalProperties": false
    },
    "checks_run": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "Passed",
              "Failed",
              "Not run",
              "Not applicable",
              "Unverified"
            ]
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "method",
          "status",
          "context",
          "result"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "unresolved_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "next_safe_action": {
      "type": "string",
      "minLength": 1
    },
    "approval_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "authorizer": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "granted",
              "denied",
              "expired"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "action",
          "authorizer",
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "granted"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "evidence"
              ]
            }
          }
        ]
      },
      "minItems": 0
    },
    "uncertain_external_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "evidence_location": {
      "type": "string",
      "minLength": 1
    },
    "recovery_location": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "current_objective",
    "authorized_scope",
    "work_completed",
    "repository_revision",
    "checks_run",
    "decisions",
    "unresolved_issues",
    "next_safe_action"
  ],
  "additionalProperties": false
}
